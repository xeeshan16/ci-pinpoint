# Copy to .env (never commit it). Pick ONE model provider; auto-detection order:
# ANTHROPIC_API_KEY > AZURE_OPENAI_ENDPOINT > OPENAI_API_KEY > CI_PINPOINT_BASE_URL > local Ollama.

# Local (default): Ollama on this machine
# OLLAMA_HOST=http://localhost:11434
# CI_PINPOINT_MODEL=qwen2.5:3b

# Any OpenAI-compatible server (vLLM, LM Studio, llama.cpp server, ...)
# CI_PINPOINT_BASE_URL=http://localhost:8000/v1
# CI_PINPOINT_MODEL=Qwen/Qwen2.5-7B-Instruct
# CI_PINPOINT_API_KEY=

# Hosted
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# Reading GitHub Actions logs (needed even for public repositories)
# GITHUB_TOKEN=

# Tuning
# CI_PINPOINT_BUDGET_TOKENS=2000
# CI_PINPOINT_TIMEOUT_S=120
# CI_PINPOINT_MAX_RETRIES=3
# CI_PINPOINT_LOG_FORMAT=json
